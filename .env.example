# Required for the "Ask My Portfolio" assistant and job-description matching.
# Without it the site still works end to end: the portfolio renders normally and
# the assistant falls back to retrieval-only answers (verbatim portfolio excerpts).
ANTHROPIC_API_KEY=

# Password for the private owner analytics dashboard at /dashboard.
# Leave unset in local dev to browse the dashboard without a password.
OWNER_DASHBOARD_PASSWORD=

# Canonical site origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
